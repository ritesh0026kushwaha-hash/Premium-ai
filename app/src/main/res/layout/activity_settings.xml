<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apni Gemini API key yahan enter karo."
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Gemini API Key"
        android:inputType="textPassword"
        android:singleLine="true" />

    <Button
        android:id="@+id/saveApiKeyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save API Key"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/clearApiKeyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete API Key"
        android:layout_marginTop="10dp" />

</LinearLayout>
